# ThreatPulse local secrets file
#
# Copy this file to "api.env" (same folder as fetcher.py) and fill in real values there.
# api.env is loaded automatically by fetcher.py on every run (via python-dotenv) and is
# already blocked from public web access by the existing .htaccess rule that denies any
# "*.env" file and any dotfile. Never commit api.env itself anywhere — only this .example
# template should be kept in version control / shared.
#
# Format: KEY=value, one per line, no quotes, no spaces around "=".

# GreyNoise Community API — free, self-serve signup at greynoise.io.
# Powers fetch_greynoise_context(): cross-references IP-type IOC Watch indicators against
# GreyNoise's classification (malicious/benign/unknown) and RIOT (known business service) data,
# folding the result into confidence_score -- a RIOT/benign hit suppresses a false-positive IP
# toward Low, a malicious hit corroborates and raises it. Picked up automatically once set here.
# Free Community tier is capped at 50 lookups/week TOTAL, shared with any manual lookups on
# greynoise.io's own Visualizer -- fetcher.py self-limits to 30/week (GREYNOISE_WEEKLY_BUDGET in
# fetcher.py) to leave headroom, checking a few never-seen IPs per run rather than all at once.
GREYNOISE_API_KEY=

# abuse.ch Auth-Key (URLhaus / ThreatFox / MalwareBazaar) — free, from auth.abuse.ch.
# One key covers all three feeds. Powers the IOC Watch panel (Phase 3) — set this and flip
# "enabled": true on the urlhaus/threatfox/malwarebazaar entries under config.json's ioc_feeds.
ABUSECH_AUTH_KEY=

# AlienVault OTX API key — free, from otx.alienvault.com/api.
# Powers the OTX API v2 upgrade (Phase 3) — set this, subscribe to a few pulse authors on
# otx.alienvault.com (OTX has no unauthenticated global firehose), and flip "enabled": true
# on the alienvault_otx_iocs entry under config.json's ioc_feeds.
OTX_API_KEY=

# NVD API key — free, instant signup at nvd.nist.gov/developers/request-an-api-key. Note: NVD
# requires a separate confirmation step after signup (nvd.nist.gov/developers/confirm-api-key,
# using the email+UUID from their activation email) before the key actually works -- using it
# before that step returns HTTP 404 on every lookup, not an auth error.
# Optional but strongly recommended: raises fetch_nvd_cvss()'s rate-limit tier from ~5
# requests/30s (unauthenticated) to 50 requests/30s, and raises its per-run lookup cap from
# 30 to 500 to match, so the historical CVSS backlog clears in a handful of runs instead of
# 60+. Picked up automatically the moment it's set here -- no config.json changes needed.
NVD_API_KEY=

# Scrape.do token — optional, shared with the mortgage-calculator project's Redfin proxy
# (same key, same api.env). If set, fetch_standard_feed() automatically retries any RSS/Atom/
# XML feed through Scrape.do's proxy network when a direct request fails (e.g. CISA's
# advisories feed, which blocks direct automated requests outright regardless of source IP).
# Uses the cheapest basic tier (datacenter proxy, no JS render) since these are static feeds,
# not JS-rendered pages. Not required -- feeds that fail without this set are simply skipped
# for that run, same as before.
SCRAPE_DO_TOKEN=
