# Make browsers check for a newer copy of the app's code on every load, so a deploy is picked up
# without a hard refresh (Oct 2026: Chrome kept serving an old js/geminiAnalysis.js after deploys).
# "no-cache" still lets the browser reuse its copy - the server just answers 304 Not Modified when
# the file hasn't changed - so this costs almost nothing. Photos and other media are left alone.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Brokerages: /dibs/b/<slug>/... serves this same app for brokerage <slug>; backend/tenant.php reads
# the slug from the requested URL and opens that brokerage's database. The plain /dibs/ URL is
# brokerage #1. (Local dev: dev-router.php does the same for PHP's built-in server.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /dibs/
    RewriteRule ^b/([a-z0-9][a-z0-9-]{1,39})$ b/$1/ [R=301,L]
    RewriteRule ^b/[a-z0-9][a-z0-9-]{1,39}/$ index.html [L]
    RewriteRule ^b/[a-z0-9][a-z0-9-]{1,39}/(.+)$ $1 [L]
</IfModule>
