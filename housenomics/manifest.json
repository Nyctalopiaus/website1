{
  "id": "/housenomics/",
  "name": "Housenomics — Full Housing Cost Calculator",
  "short_name": "Housenomics",
  "description": "Comprehensive calculator to estimate true monthly housing cost, mortgage terms, escrow, DTI affordability, and property parsing.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "lang": "en-US",
  "dir": "ltr",
  "background_color": "#0b0f19",
  "theme_color": "#0b0f19",
  "categories": ["finance", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": { "client_mode": "focus-existing" },
  "edge_side_panel": { "preferred_width": 480 },
  "shortcuts": [
    {
      "name": "Open Calculator",
      "short_name": "Calculator",
